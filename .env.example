# Copia a .env para cambiar valores. Todo tiene valor por defecto.
APP_HOST_PORT=8085
DB_HOST_PORT=3308
PMA_HOST_PORT=8086
DB_NAME=tornillo_mayor
DB_USER=tienda
DB_PASSWORD=tienda
DB_ROOT_PASSWORD=raiz-tornillo

# Clave de cifrado de tarjetas/cupones y firma del token de API.
CARD_KEY=tornillo
JWT_SECRET=tornillo-mayor-firma-api

# Atributo SameSite de la cookie de sesión. Por defecto Lax (la tienda funciona en
# cualquier navegador). Ponlo a None para los PoC cross-site de CSRF/CORS desde otra
# página (en ese caso usa Firefox o HTTPS; Chrome descarta SameSite=None sin Secure).
COOKIE_SAMESITE=Lax
